<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- Confía en el certificado empaquetado para el backend de desarrollo -->
  <domain-config cleartextTrafficPermitted="false">
    <domain includeSubdomains="false">192.168.45.18</domain>
    <trust-anchors>
      <certificates src="@raw/backend_cert"/>
    </trust-anchors>
  </domain-config>
  <!-- Resto del tráfico usa CAs del sistema -->
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system"/>
    </trust-anchors>
  </base-config>
</network-security-config>
